{
  "manifest_version": 3,
  "name": "Captionary - Interactive Video Transcript & Vocabulary",
  "version": "1.0.0",
  "description": "Interactive YouTube transcript panel with instant word meanings, phonetics, audio pronunciation, and vocabulary builder for language learners.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Captionary Settings & Vocabulary",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "https://api.datamuse.com/*",
    "https://clients5.google.com/*",
    "https://en.wiktionary.org/*",
    "https://api.mymemory.translated.net/*",
    "https://api.dictionaryapi.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "content.css"
      ],
      "matches": [
        "*://www.youtube.com/*"
      ]
    }
  ]
}